# RevenueCat v1 secret API key. Sadece Supabase Edge Function secret olarak tanımlanır.
# İstemciye, Vite ortamına veya Git deposuna gerçek değeri koymayın.
REVENUECAT_SECRET_API_KEY=

# E-posta yaşam döngüsü. Gerçek değerler yalnızca Supabase Edge Function secret olmalı.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SEND_EMAIL_HOOK_SECRET=
LIFECYCLE_CRON_SECRET=
PUBLIC_SITE_URL=https://borcama.com

# Borcama Asistanı. Finansal özetler nedeniyle yalnız billing etkin Paid Service
# projesinin anahtarı kullanılmalı; anahtarı istemciye veya VITE_ değişkenine koymayın.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_PAID_SERVICE_CONFIRMED=false
