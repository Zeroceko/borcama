{
  "crons": [
    { "path": "/api/lifecycle-emails", "schedule": "15 7 * * *" }
  ],
  "redirects": [
    {
      "source": "/backoffice",
      "has": [{ "type": "host", "value": "borcama.com" }],
      "destination": "https://crm.borcama.com",
      "permanent": true
    },
    {
      "source": "/backoffice/:path*",
      "has": [{ "type": "host", "value": "borcama.com" }],
      "destination": "https://crm.borcama.com/:path*",
      "permanent": true
    },
    {
      "source": "/ceo",
      "has": [{ "type": "host", "value": "borcama.com" }],
      "destination": "https://crm.borcama.com/ceo",
      "permanent": true
    },
    {
      "source": "/marketing",
      "has": [{ "type": "host", "value": "borcama.com" }],
      "destination": "https://crm.borcama.com/marketing",
      "permanent": true
    },
    {
      "source": "/analytics",
      "has": [{ "type": "host", "value": "borcama.com" }],
      "destination": "https://crm.borcama.com/analytics",
      "permanent": true
    }
  ],
  "headers": [
    { "source": "/demo", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    {
      "source": "/borcama-logo.png",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://cdn.paddle.com https://cdn.jsdelivr.net https://www.googletagmanager.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.paddle.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com; connect-src 'self' https://o4512024083562496.ingest.de.sentry.io https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com https://api.revenuecat.com https://e.revenue.cat https://*.paddle.com https://cdn.jsdelivr.net https://www.google-analytics.com https://region1.google-analytics.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com; frame-src https://challenges.cloudflare.com https://*.paddle.com https://pay.rev.cat; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://*.paddle.com\"), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "crm.borcama.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/backoffice",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
