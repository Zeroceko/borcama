{
  "crons": [
    { "path": "/api/lifecycle-emails", "schedule": "15 7 * * *" }
  ],
  "headers": [
    {
      "source": "/borcama-logo.png",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://cdn.paddle.com https://cdn.jsdelivr.net https://www.googletagmanager.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.paddle.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com https://api.revenuecat.com https://e.revenue.cat https://*.paddle.com https://cdn.jsdelivr.net https://www.google-analytics.com https://region1.google-analytics.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net; frame-src https://challenges.cloudflare.com https://*.paddle.com https://pay.rev.cat; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://*.paddle.com\"), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/backoffice",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/ceo",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/marketing",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/refund-policy", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/araclar", "destination": "/index.html" },
    { "source": "/araclar/:path*", "destination": "/index.html" },
    { "source": "/rehber", "destination": "/index.html" },
    { "source": "/rehber/:path*", "destination": "/index.html" },
    { "source": "/upgrade", "destination": "/index.html" },
    { "source": "/welcome", "destination": "/index.html" },
    { "source": "/classic", "destination": "/index.html" },
    { "source": "/landing-v2", "destination": "/index.html" },
    { "source": "/summary", "destination": "/index.html" },
    { "source": "/debts", "destination": "/index.html" },
    { "source": "/payments", "destination": "/index.html" },
    { "source": "/debt-plan", "destination": "/index.html" },
    { "source": "/income", "destination": "/index.html" },
    { "source": "/expenses", "destination": "/index.html" },
    { "source": "/assets", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/backoffice", "destination": "/index.html" },
    { "source": "/ceo", "destination": "/index.html" }
    ,{ "source": "/marketing", "destination": "/index.html" }
  ]
}
