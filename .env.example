# Bu dosyayı .env.local olarak kopyalayın ve kendi Supabase bilgilerinizi girin.
#
# Yerel gelistirme icin YALNIZ su dort deger gerekir:
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY,
#   VITE_TURNSTILE_SITE_KEY, VITE_REVENUECAT_IOS_API_KEY
# Hicbiri tanimli degilse uygulama yerel demo moduna duser ve calisir.
# Kurulumun tamami: docs/yeni-gelistirici-kurulum.md
# Hangi sirrin nerede durdugu: docs/devir-paketi.md > Sir envanteri
# Supabase panelinizde: Project Settings → API sayfasında bulunur.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opsiyonel: Supabase Auth bot koruması etkinse Cloudflare Turnstile site anahtarı
VITE_TURNSTILE_SITE_KEY=

# Google Ads dönüşüm etiketleri. Satın alma etiketi mevcut hesabınızdaki etikettir;
# ilk borç etiketi Google Ads panelinde oluşturulduktan sonra buraya yazılır.
VITE_GOOGLE_ADS_PURCHASE_LABEL=
VITE_GOOGLE_ADS_FIRST_DEBT_LABEL=

# RevenueCat Web uygulamasındaki public API key (gizli anahtar değildir)
VITE_REVENUECAT_PUBLIC_API_KEY=
# production veya sandbox; boş bırakılırsa uygulama ödeme akışını başlatmaz.
VITE_REVENUECAT_ENVIRONMENT=production
# Native uygulamalar icin platform basina RevenueCat public anahtarlari.
# Yalniz Capacitor build'lerinde kullanilir; web bunlari okumaz.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=

# Yalnız Supabase Edge Function secret olarak tanımlanır. İstemciye konmaz.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# RevenueCat dashboard'daki iOS app public identifier'i (app_...); bundle ID degildir.
REVENUECAT_IOS_APP_ID=

# Yalnızca Supabase Edge Function secret olarak tanımlanır; VITE_ öneki verilmez.
# Paddle API anahtarında Customers: Read, Subscriptions: Read + Write izinleri gerekir.
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=production
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=production

# Vercel'in günlük yaşam döngüsü e-posta görevi için gizli değerler.
# CRON_SECRET Vercel tarafından /api/lifecycle-emails çağrısını doğrular.
# LIFECYCLE_CRON_SECRET aynı değerle Supabase Edge Function secret olarak da tanımlanır.
CRON_SECRET=
LIFECYCLE_CRON_SECRET=
SUPABASE_URL=https://xxxxxxxx.supabase.co

# ---------------------------------------------------------------------------
# Asagidakiler bu dosyaya YAZILMAZ. Supabase Edge Function secret'i olarak
# tanimlidir (Project Settings -> Edge Functions -> Secrets). Burada yalniz
# envanter olarak listelenir; aciklamalari docs/devir-paketi.md icindedir.
#
#   SUPABASE_SERVICE_ROLE_KEY   tam yetkili anahtar, asla istemciye gitmez
#   SEND_EMAIL_HOOK_SECRET      Supabase Send Email Hook imzasi
#   RESEND_API_KEY              e-posta gonderimi
#   RESEND_WEBHOOK_SECRET       teslimat / bounce / sikayet olaylari
#   GEMINI_API_KEY              asistan
#   GEMINI_MODEL                asistan modeli
#   GEMINI_PAID_SERVICE_CONFIRMED
#   REVENUECAT_SECRET_API_KEY   abonelik dogrulama
#   SHOPIER_PRO_PRODUCT_ID      Shopier koprusu
#   ANALYTICS_SESSION_SECRET    oturum kimligi imzasi
#   PUBLIC_SITE_URL             e-posta baglantilarinin tabani
#
# Vercel ortam degiskeni olarak tanimli olanlar:
#
#   SHOPIER_ACCESS_TOKEN
#   SHOPIER_BRIDGE_SECRET       Supabase tarafindaki degerle ayni olmali
#   SHOPIER_PRODUCT_ID
# ---------------------------------------------------------------------------
