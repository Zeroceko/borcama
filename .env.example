# Bu dosyayı .env.local olarak kopyalayın ve kendi Supabase bilgilerinizi girin.
# Supabase panelinizde: Project Settings → API sayfasında bulunur.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opsiyonel: Supabase Auth bot koruması etkinse Cloudflare Turnstile site anahtarı
VITE_TURNSTILE_SITE_KEY=

# RevenueCat Web uygulamasındaki public API key (gizli anahtar değildir)
VITE_REVENUECAT_PUBLIC_API_KEY=
# production veya sandbox; boş bırakılırsa uygulama ödeme akışını başlatmaz.
VITE_REVENUECAT_ENVIRONMENT=production

# Yalnızca Supabase Edge Function secret olarak tanımlanır; VITE_ öneki verilmez.
# Paddle API anahtarında Customers: Read, Subscriptions: Read + Write izinleri gerekir.
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=production
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=production

# Vercel'in günlük yaşam döngüsü e-posta görevi için gizli değerler.
# CRON_SECRET Vercel tarafından /api/lifecycle-emails çağrısını doğrular.
# LIFECYCLE_CRON_SECRET aynı değerle Supabase Edge Function secret olarak da tanımlanır.
CRON_SECRET=
LIFECYCLE_CRON_SECRET=
SUPABASE_URL=https://xxxxxxxx.supabase.co
